<?xml version="1.0" encoding="utf-8"?>
<!-- Pipeline workflow CSDL — reference example (not platform-required).
     These entity types are used by the LeadPlan deployment pipeline demo. -->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Temper" xmlns="http://docs.oasis-open.org/odata/ns/edm">

      <EntityType Name="LeadPlan">
        <Key><PropertyRef Name="id"/></Key>
        <Property Name="id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="test_workflow_id" Type="Edm.String"/>
        <Property Name="review_workflow_id" Type="Edm.String"/>
        <Property Name="deploy_workflow_id" Type="Edm.String"/>
        <Property Name="deploy_url" Type="Edm.String"/>
        <Property Name="reason" Type="Edm.String"/>
        <NavigationProperty Name="TestWorkflow" Type="Temper.TestWorkflow">
          <ReferentialConstraint Property="test_workflow_id" ReferencedProperty="id"/>
        </NavigationProperty>
        <NavigationProperty Name="ReviewWorkflow" Type="Temper.ReviewWorkflow">
          <ReferentialConstraint Property="review_workflow_id" ReferencedProperty="id"/>
        </NavigationProperty>
        <NavigationProperty Name="DeployWorkflow" Type="Temper.DeployWorkflow">
          <ReferentialConstraint Property="deploy_workflow_id" ReferencedProperty="id"/>
        </NavigationProperty>
      </EntityType>

      <EntityType Name="TestWorkflow">
        <Key><PropertyRef Name="id"/></Key>
        <Property Name="id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="test_count" Type="Edm.String"/>
        <Property Name="coverage" Type="Edm.String"/>
        <Property Name="failures" Type="Edm.String"/>
        <Property Name="error_log" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="ReviewWorkflow">
        <Key><PropertyRef Name="id"/></Key>
        <Property Name="id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="reviewer" Type="Edm.String"/>
        <Property Name="comments" Type="Edm.String"/>
        <Property Name="change_requests" Type="Edm.String"/>
        <Property Name="reason" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="DeployWorkflow">
        <Key><PropertyRef Name="id"/></Key>
        <Property Name="id" Type="Edm.String" Nullable="false"/>
        <Property Name="Status" Type="Edm.String"/>
        <Property Name="environment" Type="Edm.String"/>
        <Property Name="version" Type="Edm.String"/>
        <Property Name="deploy_url" Type="Edm.String"/>
        <Property Name="reason" Type="Edm.String"/>
      </EntityType>



      <!-- Callable IOA action twins (ADR-0193) -->
      <Action Name="Begin" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.DeployWorkflow" Nullable="false"/>
        <ReturnType Type="Temper.DeployWorkflow"/>
      </Action>

      <Action Name="StartDeploy" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.DeployWorkflow" Nullable="false"/>
        <Parameter Name="environment" Type="Edm.String" Nullable="false"/>
        <Parameter Name="version" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.DeployWorkflow"/>
      </Action>

      <Action Name="Verify" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.DeployWorkflow" Nullable="false"/>
        <ReturnType Type="Temper.DeployWorkflow"/>
      </Action>

      <Action Name="GoLive" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.DeployWorkflow" Nullable="false"/>
        <Parameter Name="deploy_url" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.DeployWorkflow"/>
      </Action>

      <Action Name="Rollback" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.DeployWorkflow" Nullable="false"/>
        <Parameter Name="reason" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.DeployWorkflow"/>
      </Action>

      <Action Name="StartPlanning" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.LeadPlan" Nullable="false"/>
        <ReturnType Type="Temper.LeadPlan"/>
      </Action>

      <Action Name="StartTesting" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.LeadPlan" Nullable="false"/>
        <ReturnType Type="Temper.LeadPlan"/>
      </Action>

      <Action Name="StartReview" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.LeadPlan" Nullable="false"/>
        <Parameter Name="test_results" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.LeadPlan"/>
      </Action>

      <Action Name="StartDeploy" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.LeadPlan" Nullable="false"/>
        <Parameter Name="review_approval" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.LeadPlan"/>
      </Action>

      <Action Name="Complete" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.LeadPlan" Nullable="false"/>
        <Parameter Name="deploy_url" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.LeadPlan"/>
      </Action>

      <Action Name="Fail" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.LeadPlan" Nullable="false"/>
        <Parameter Name="reason" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.LeadPlan"/>
      </Action>

      <Action Name="Begin" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.ReviewWorkflow" Nullable="false"/>
        <ReturnType Type="Temper.ReviewWorkflow"/>
      </Action>

      <Action Name="Approve" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.ReviewWorkflow" Nullable="false"/>
        <Parameter Name="reviewer" Type="Edm.String" Nullable="false"/>
        <Parameter Name="comments" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.ReviewWorkflow"/>
      </Action>

      <Action Name="RequestChanges" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.ReviewWorkflow" Nullable="false"/>
        <Parameter Name="reviewer" Type="Edm.String" Nullable="false"/>
        <Parameter Name="change_requests" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.ReviewWorkflow"/>
      </Action>

      <Action Name="Reject" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.ReviewWorkflow" Nullable="false"/>
        <Parameter Name="reviewer" Type="Edm.String" Nullable="false"/>
        <Parameter Name="reason" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.ReviewWorkflow"/>
      </Action>

      <Action Name="ReSubmit" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.ReviewWorkflow" Nullable="false"/>
        <ReturnType Type="Temper.ReviewWorkflow"/>
      </Action>

      <Action Name="Begin" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.TestWorkflow" Nullable="false"/>
        <ReturnType Type="Temper.TestWorkflow"/>
      </Action>

      <Action Name="RecordPass" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.TestWorkflow" Nullable="false"/>
        <Parameter Name="test_count" Type="Edm.String" Nullable="false"/>
        <Parameter Name="coverage" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.TestWorkflow"/>
      </Action>

      <Action Name="RecordFail" IsBound="true">
        <Parameter Name="bindingParameter" Type="Temper.TestWorkflow" Nullable="false"/>
        <Parameter Name="failures" Type="Edm.String" Nullable="false"/>
        <Parameter Name="error_log" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Temper.TestWorkflow"/>
      </Action>

      <EntityContainer Name="Service">
        <EntitySet Name="LeadPlans" EntityType="Temper.LeadPlan">
          <NavigationPropertyBinding Path="TestWorkflow" Target="TestWorkflows"/>
          <NavigationPropertyBinding Path="ReviewWorkflow" Target="ReviewWorkflows"/>
          <NavigationPropertyBinding Path="DeployWorkflow" Target="DeployWorkflows"/>
        </EntitySet>
        <EntitySet Name="TestWorkflows" EntityType="Temper.TestWorkflow"/>
        <EntitySet Name="ReviewWorkflows" EntityType="Temper.ReviewWorkflow"/>
        <EntitySet Name="DeployWorkflows" EntityType="Temper.DeployWorkflow"/>
      </EntityContainer>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
