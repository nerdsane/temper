FROM node:22-alpine AS build
ARG TEMPER_API_URL
ENV TEMPER_API_URL=${TEMPER_API_URL}
WORKDIR /app
COPY ui/observe/package*.json ./
RUN npm ci
COPY ui/observe/ ./
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
