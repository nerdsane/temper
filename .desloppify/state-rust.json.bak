    "review::.::holistic::cross_module_architecture::cli_storage_cross_layer_hub::a87f303b": {
      "id": "review::.::holistic::cross_module_architecture::cli_storage_cross_layer_hub::a87f303b",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "CLI storage module couples orchestration, backend IO, and server registry internals in one seam.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "`crates/temper-cli/src/serve/storage.rs:7-15` mixes imports from server domain types and concrete storage adapters, then performs connection/migration/upsert/restore in the same module (`:39-127`, `:212-369`, `:472-499`).",
          "`crates/temper-server/src/observe/evolution/records_list.rs:28-31` depends on runtime persistent-store behavior that this CLI module effectively shapes at startup, creating a wide blast radius for persistence changes."
        ],
        "suggestion": "Introduce a persistence bootstrap boundary (e.g., `SpecPersistenceBootstrap`) owned by the server/persistence layer; move registry restoration and backend-specific translation out of CLI, leaving CLI to call a narrow boot API.",
        "reasoning": ""
      },
      "status": "auto_resolved",
