    "review::.::holistic::high_level_elegance::evolution_domain_policy_scattered::e08b5691": {
      "id": "review::.::holistic::high_level_elegance::evolution_domain_policy_scattered::e08b5691",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Evolution insight policy and output contract ownership are split across ad hoc modules.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "crates/temper-server/src/insight_generator.rs:48-419 includes multiple domain responsibilities (aggregation, unmet-intent resolution logic, feature-request generation, threshold constants, error taxonomy) in a single module.",
          "crates/temper-server/src/observe/evolution/records_list.rs:43-50 and 100-107 flatten arbitrary JSON `data` into endpoint payloads, so externally visible shape is implicitly driven by whichever generator wrote the blob.",
          "The combined pattern makes domain policy edits and API response edits cross-cut each other, increasing ripple and reducing predictable ownership."
        ],
        "suggestion": "Split evolution into explicit submodules (`insight_rules`, `unmet_intent_rules`, `feature_request_rules`) and define typed response DTOs for record-list handlers instead of JSON field merging.",
