    "review::.::holistic::authorization_consistency::observe_surface_breaks_readonly_and_tenant_boundaries::65cbb59e": {
      "id": "review::.::holistic::authorization_consistency::observe_surface_breaks_readonly_and_tenant_boundaries::65cbb59e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "`/observe` includes unauthenticated mutations and cross-tenant data exposure patterns.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/observe/mod.rs",
          "crates/temper-server/src/observe/evolution/operations.rs",
          "crates/temper-server/src/observe/entities.rs",
          "crates/temper-server/src/state/entity_ops.rs"
        ],
        "evidence": [
          "Observe router docs claim read-only except verify (`observe/mod.rs:135-137`) but route table exposes PATCH `/evolution/feature-requests/{id}` (`188-190`).",
          "Patch handler directly updates Turso without authz gate (`operations.rs:301-337`).",
          "`list_entities` enumerates all actor keys without tenant filter (`entities.rs:22-49`), and history fallback reads by non-tenant persistence key (`entities.rs:101-103`) despite tenant-qualified persistence IDs elsewhere (`state/entity_ops.rs:435-436`)."
        ],
        "suggestion": "Move mutating observe endpoints under authenticated `/api` (or add explicit authz in observe), add tenant filter enforcement for entity listing/history, and normalize persistence key handling to tenant-qualified IDs in all read paths.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-05T19:56:00+00:00",
