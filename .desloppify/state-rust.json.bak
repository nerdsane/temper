    "review::.::holistic::mid_level_elegance::dispatch_layer_depth::90ef82b4": {
      "id": "review::.::holistic::mid_level_elegance::dispatch_layer_depth::90ef82b4",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Entity action dispatch traverses 3-4 layers of wrapper methods before reaching core transition logic, with each layer adding small amounts of functionality (trajectory recording, reaction dispatch, integration await) but creating a deep call chain that is hard to follow.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/dispatch/effects.rs",
          "crates/temper-server/src/state/dispatch/wasm.rs",
          "crates/temper-server/src/state/dispatch/cross_entity.rs"
        ],
        "evidence": [
          "dispatch() -> dispatch_tenant_action_core() -> [transition eval] -> run_post_dispatch_effects() -> [trajectory, SSE, webhooks, WASM, spawn]",
          "dispatch_bound_action (11 params) -> dispatch() (via DispatchCommand) -> dispatch_tenant_action_core()",
          "dispatch_wasm_integrations_internal -> dispatch_single_integration -> [WASM host call chain]",
          "effects.rs has PostDispatchContext struct to thread context, which helps, but the call chain itself is still 3-4 deep"
        ],
        "suggestion": "Consider a pipeline or middleware pattern where each cross-cutting concern (trajectory, SSE, reactions, WASM) is a composable stage rather than a nested call. This would make the dispatch flow linear and each stage independently testable.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-06T03:20:24+00:00",
      "last_seen": "2026-03-06T03:20:24+00:00",
