    "review::.::holistic::mid_level_elegance::dispatch-three-layer-wrapper-chain-partially-unwound::aeb6a570": {
      "id": "review::.::holistic::mid_level_elegance::dispatch-three-layer-wrapper-chain-partially-unwound::aeb6a570",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "The dispatch chain was refactored from a three-layer wrapper (dispatch_action -> dispatch_tenant_action -> dispatch_tenant_action_ext) to DispatchCommand, but the old layers are still present as deprecated convenience wrappers. This creates a transitional state where callers can use either path, making the seam design inconsistent.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/dispatch/mod.rs"
        ],
        "evidence": [
          "actions.rs lines 72-90: dispatch_action is deprecated but still functional",
          "actions.rs lines 92-117: dispatch_tenant_action wraps dispatch(DispatchCommand{..})",
          "actions.rs line 119: dispatch_tenant_action_ext wraps the same",
          "mod.rs lines 80-84: DispatchExtOptions is explicitly 'Deprecated: prefer DispatchCommand'"
        ],
        "suggestion": "Complete the migration by updating all internal callers to use DispatchCommand directly, then remove the deprecated wrappers. The transition has stalled halfway.",
