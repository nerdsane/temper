    "review::.::holistic::logic_clarity::insight_resolution_ignores_temporal_order::0c5e68f2": {
      "id": "review::.::holistic::logic_clarity::insight_resolution_ignores_temporal_order::0c5e68f2",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Unmet-intent resolution logic ignores timestamp ordering and can mark active failures as resolved",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "`generate_insights` sets `resolved` based on entity presence in `submitted_types`, not whether submit happened after failures (`insight_generator.rs:112-119`).",
          "`generate_unmet_intents` uses `submitted_specs.contains_key` similarly (`insight_generator.rs:307-309`), so later failures can still be labeled resolved in records served by evolution endpoints."
        ],
        "suggestion": "Track submit timestamps per entity and resolve only when `submit_timestamp >= last_failure_timestamp` for each grouped signal/intent; keep groups open when failures continue after submit.",
        "reasoning": ""
      },
      "status": "auto_resolved",
