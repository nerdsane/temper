    "review::.::holistic::dependency_health::backend_specific_dependency_leaks_into_api_behavior::5efb58bb": {
      "id": "review::.::holistic::dependency_health::backend_specific_dependency_leaks_into_api_behavior::5efb58bb",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Turso-specific behavior leaks into server features despite multi-backend CLI surface",
      "detail": {
        "holistic": true,
        "dimension": "dependency_health",
        "related_files": [
          "crates/temper-cli/src/serve/mod.rs",
          "crates/temper-server/src/api.rs",
          "crates/temper-server/src/observe/evolution/operations.rs"
        ],
        "evidence": [
          "`serve/mod.rs` supports Postgres/Turso/Redis initialization (`lines ~74-127`), but multiple API/evolution handlers directly assume Turso via `state.persistent_store()`.",
          "When Turso is unavailable, handlers return empty/silent fallbacks (`operations.rs` lines ~297-299, `api.rs` lines ~609-620 and ~959-970) instead of backend-neutral behavior.",
          "This creates capability skew where the configured backend controls endpoint semantics, not just storage implementation."
        ],
        "suggestion": "Introduce a backend-neutral persistence trait for decisions/policies/evolution records and route all handlers through that abstraction; enforce explicit `501/503` for unsupported capabilities instead of silent empty responses.",
        "reasoning": ""
