      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "ServerState constructors automatically call register_builtin_wasm_modules() which compiles an embedded WASM binary, coupling server initialization to WASM compilation",
      "detail": {
