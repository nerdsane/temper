    "review::.::holistic::error_consistency::error-rwlock-unwrap-inconsistency::4fd59a92": {
      "id": "review::.::holistic::error_consistency::error-rwlock-unwrap-inconsistency::4fd59a92",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "RwLock access uses two different patterns: .unwrap() with ci-ok annotation and .ok().and_then() silent swallowing",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "crates/temper-server/src/state/mod.rs",
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/dispatch/mod.rs"
        ],
        "evidence": [
          "state/mod.rs line 403: registry.read().unwrap() -- panics on poison",
          "state/dispatch/actions.rs line 46: reaction_dispatcher.read().ok().and_then(|slot| slot.clone()) -- silently ignores poison",
          "state/dispatch/mod.rs line 116: denial_reason.lock().ok().and_then(...) -- silently ignores poison",
          "Both patterns appear in production paths, not just tests"
        ],
        "suggestion": "Pick one strategy: if lock poisoning is truly impossible (single-threaded actor), use .unwrap() consistently with ci-ok. If poisoning can happen, handle it consistently with Result propagation.",
        "reasoning": ""
      },
