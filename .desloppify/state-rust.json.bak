    "review::.::holistic::authorization_consistency::system_default_principal_bypass::3871150a": {
      "id": "review::.::holistic::authorization_consistency::system_default_principal_bypass::3871150a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Missing principal headers become `System`, bypassing Cedar checks on gated routes.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-authz/src/context.rs",
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/state/entity_ops.rs",
          "crates/temper-server/src/authz_helpers.rs"
        ],
        "evidence": [
          "`SecurityContext::from_headers` initializes `kind` as `PrincipalKind::System` and maps unknown kind values to `System` (`context.rs:53-69`).",
          "`AuthzEngine::authorize_or_bypass` returns `Allow` whenever principal is `System` (`engine.rs:217-227`).",
          "Server auth gate paths call `authorize_with_context`, which delegates to `authorize_or_bypass` (`entity_ops.rs:253-268`); many handlers build context from headers only (`authz_helpers.rs:33-39`)."
        ],
        "suggestion": "Change header-derived default principal to a non-bypass identity (for example `Anonymous`/`Agent` with deny-by-default), reserve `System` to explicit internal call sites (`SecurityContext::system()` only), and require trusted internal marker before allowing any bypass path.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
