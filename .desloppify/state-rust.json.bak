    "review::.::holistic::authorization_consistency::implicit_tenant_fallback_authorization_drift::c6aebda7": {
      "id": "review::.::holistic::authorization_consistency::implicit_tenant_fallback_authorization_drift::c6aebda7",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Missing tenant header silently falls back to arbitrary/default tenant instead of explicit rejection",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/odata/common.rs",
          "crates/temper-server/src/observe/entities.rs"
        ],
        "evidence": [
          "`extract_tenant` chooses first registered tenant when `x-tenant-id` is missing, then falls back to `TenantId::default()` (`odata/common.rs:13-37`).",
          "`get_entity_history` uses this derived tenant for actor lookup and event-store reads (`observe/entities.rs:64-106`).",
          "This makes authorization outcomes depend on registry/default ordering rather than explicit tenant identity."
        ],
        "suggestion": "Require an explicit tenant for multi-tenant endpoints: return `400`/`401` when `x-tenant-id` is missing or unknown, and only permit fallback in an explicitly configured single-tenant compatibility mode. Centralize this as a strict tenant resolver shared by OData and observe handlers.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-03-05T22:14:24+00:00",
