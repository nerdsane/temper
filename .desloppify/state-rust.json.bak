    "review::.::holistic::high_level_elegance::init_experience_misaligned_with_product_contract::12ad4429": {
      "id": "review::.::holistic::high_level_elegance::init_experience_misaligned_with_product_contract::12ad4429",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "CLI init scaffolds a generic Rust app, not the governance/spec-first workflow described as primary product contract",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "README.md",
          "crates/temper-cli/src/init/mod.rs"
        ],
        "evidence": [
          "README positions the primary usage model as agent-driven spec submission via Temper APIs and verification cascade (README.md:74-102, README.md:111-119).",
          "Init command creates a hello-world `main.rs`, a placeholder Cargo manifest, and generic next steps (`temper codegen`) instead of a runnable spec-first governance flow (crates/temper-cli/src/init/mod.rs:90-105).",
          "Scaffolded structure can lead users toward historical Rust-app ownership instead of the documented domain ownership boundary (Temper-mediated operations)."
        ],
        "suggestion": "Rework `temper init` into a contract-aligned bootstrap: generate minimal IOA + CSDL + policy stubs, include a submit/verify/apply command path, and remove or de-emphasize generic Rust-app scaffolding unless explicitly requested via a separate template mode.",
