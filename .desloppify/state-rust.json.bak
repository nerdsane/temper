    "review::.::holistic::mid_level_elegance::policy_persistence_path_is_inconsistent::25d00621": {
      "id": "review::.::holistic::mid_level_elegance::policy_persistence_path_is_inconsistent::25d00621",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Policy handlers diverge on persistence semantics, causing restart-time split brain",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "crates/temper-server/src/api.rs",
          "crates/temper-cli/src/serve/mod.rs",
          "crates/temper-store-turso/src/store.rs"
        ],
        "evidence": [
          "`handle_put_policies` and `handle_add_policy_rule` (`api.rs` lines ~334-546) only update `state.tenant_policies` in memory; they do not call `upsert_tenant_policy`.",
          "`handle_approve_decision` (`api.rs` lines ~731-742) does persist policies to Turso, creating a different lifecycle for logically similar policy updates.",
          "Startup in `serve/mod.rs` (`lines ~241-269`) hydrates policies from Turso into memory, so in-memory-only updates are lost after restart."
        ],
        "suggestion": "Centralize policy mutation behind one service method that always performs validate -> in-memory commit -> durable upsert (or explicit transaction/rollback), then reuse it across approve and CRUD handlers.",
        "reasoning": ""
      },
      "status": "auto_resolved",
