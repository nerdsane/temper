    "review::.::holistic::cross_module_architecture::storage-boundary-leakage::a0fcf195": {
      "id": "review::.::holistic::cross_module_architecture::storage-boundary-leakage::a0fcf195",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "CLI storage module is a cross-layer hub that couples backend plumbing to server registry internals.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "`storage.rs` owns DB connection/migration (`connect_postgres_store`) and also reconstructs server `SpecRegistry` state (`load_registry_from_postgres`/`load_registry_from_turso`) using server internal types.",
          "The same file depends on `temper_server::registry::*` and `temper_server::event_store::ServerEventStore` while serving CLI concerns, collapsing boundaries between CLI bootstrap, persistence adapter, and server domain model.",
          "`records_list.rs` separately reaches directly into persistent store APIs, showing no shared intermediate boundary for storage-facing read models."
        ],
        "suggestion": "Extract a backend-neutral persistence adapter in server/runtime (e.g., `SpecPersistencePort`) and move registry restore/upsert orchestration there; keep CLI limited to wiring/config and call that port. Route observe handlers through the same port/read-service instead of direct store calls.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-05T21:04:58+00:00",
      "last_seen": "2026-03-05T21:04:58+00:00",
      "resolved_at": "2026-03-05T22:14:24+00:00",
      "reopen_count": 0,
      "lang": "rust",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::cross_module_architecture::duplicated-backend-restore-flow::c57cfdd9": {
      "id": "review::.::holistic::cross_module_architecture::duplicated-backend-restore-flow::c57cfdd9",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Postgres and Turso registry restoration are duplicated, increasing drift risk in a critical cross-module seam.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/insight_generator.rs"
        ],
        "evidence": [
          "`load_registry_from_postgres` and `load_registry_from_turso` duplicate grouping, CSDL extraction, IOA pair building, tenant registration, and verification-status restoration logic (storage.rs lines 244-290 vs 319-365).",
          "Only row fetch/parsing differs, but core orchestration is copied, so any schema/registration rule change must be patched in multiple branches.",
          "Given other domain pipelines already have branching heuristics (`insight_generator.rs`), this duplication compounds subsystem-level rule drift risk."
        ],
        "suggestion": "Introduce a shared restore pipeline that accepts an iterator of normalized spec rows plus constraints; keep backend-specific code only at row loading/parsing boundaries.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-05T21:04:58+00:00",
      "last_seen": "2026-03-05T21:04:58+00:00",
      "resolved_at": "2026-03-05T22:14:24+00:00",
      "reopen_count": 0,
      "lang": "rust",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::high_level_elegance::inconsistent-unmet-intent-resolution-rule::2c847883": {
      "id": "review::.::holistic::high_level_elegance::inconsistent-unmet-intent-resolution-rule::2c847883",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Two insight paths encode conflicting definitions of when an unmet intent is resolved.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "`generate_insights` marks an entity resolved when `submitted_types` contains that entity type, and `has_submit_spec` is set for any `SubmitSpec` action regardless of success (insight_generator.rs lines 83-93, 112).",
          "`generate_unmet_intents` only records submit events when `entry.action == \"SubmitSpec\" && entry.success` (lines 283-285), so failed submit attempts are unresolved there.",
          "The observe endpoint exposes open/resolved status filtering semantics (`records_list.rs` params status docs, lines 14-15), so contradictory producer rules create incoherent top-level behavior for consumers."
        ],
        "suggestion": "Define one canonical `ResolutionPolicy` (success-required or not) in a shared domain helper and make both insight/unmet-intent generators depend on it; add regression tests asserting parity between both outputs for mixed success/failure SubmitSpec trajectories.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-05T21:04:58+00:00",
      "last_seen": "2026-03-05T21:04:58+00:00",
      "resolved_at": "2026-03-05T22:14:24+00:00",
      "reopen_count": 0,
      "lang": "rust",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::high_level_elegance::serverstate-service-locator-sprawl::023f1096": {
      "id": "review::.::holistic::high_level_elegance::serverstate-service-locator-sprawl::023f1096",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "ServerState is used as a broad service locator across unrelated concerns, obscuring ownership boundaries.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "crates/temper-server/src/events.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs",
          "crates/temper-server/src/state/dispatch_blocking.rs"
        ],
        "evidence": [
          "`events.rs` directly accesses `state.event_tx` and builds SSE behavior inline (lines 46-58).",
          "`records_list.rs` directly accesses `state.persistent_store()` and builds response projections in handlers (lines 25-65, 91-117).",
          "`dispatch_blocking.rs` is implemented as an extension on `ServerState` calling deep internal dispatch (`dispatch_wasm_integrations_internal`) with an 8-field request bag (lines 13-21, 31-49)."
        ],
        "suggestion": "Split `ServerState` into narrower capability traits/services (event stream service, evolution query service, integration dispatch service) and inject those into handlers; keep `ServerState` as composition root rather than direct cross-cutting API surface.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
