    "review::.::holistic::authorization_consistency::mixed_bypass_semantics_across_surfaces::da9bfe41": {
      "id": "review::.::holistic::authorization_consistency::mixed_bypass_semantics_across_surfaces::da9bfe41",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Bypass behavior is implemented inconsistently across endpoints and execution surfaces.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/observe/evolution/operations.rs",
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/wasm_authz_gate.rs"
        ],
        "evidence": [
          "`AuthzEngine` defines centralized bypass only for `System` principals.",
          "`handle_update_feature_request` adds a separate manual `Admin` bypass instead of using the same helper path as sibling observe endpoints.",
          "`PermissiveWasmAuthzGate` unconditionally allows host function access, introducing a third bypass mode outside Cedar policies."
        ],
        "suggestion": "Consolidate bypass policy into one authorization abstraction with explicit policy flags and audit hooks; remove ad-hoc per-handler bypass branches and make permissive WASM mode opt-in behind strict environment gating plus startup warnings.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
