    "review::.::holistic::cross_module_architecture::temper-server-dependency-fan-out::1ff233b9": {
      "id": "review::.::holistic::cross_module_architecture::temper-server-dependency-fan-out::1ff233b9",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "temper-server depends on 12 internal crates, making it a coupling hub with high blast radius",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-server/Cargo.toml"
        ],
        "evidence": [
          "temper-server/Cargo.toml lists dependencies on temper-runtime, temper-odata, temper-spec, temper-jit, temper-store-postgres, temper-store-turso, temper-store-redis, temper-observe, temper-authz, temper-evolution, temper-wasm, and temper-mcp. This means any change to any of these 12 crates triggers a recompile of temper-server. The 'observe' feature gate exists for temper-verify but the others are unconditional."
        ],
        "suggestion": "Consider whether temper-mcp and temper-wasm could be behind feature gates or split into separate server extension crates. The store backends (postgres, turso, redis) could potentially be abstracted behind a single store trait to reduce the direct dependency count.",
        "reasoning": ""
      },
