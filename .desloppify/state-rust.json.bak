      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Record ID generation truncates UUID entropy to 16 bits, making collisions plausible.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "crates/temper-evolution/src/records.rs",
          "crates/temper-evolution/src/lib.rs"
        ],
        "evidence": [
          "`crates/temper-evolution/src/records.rs:347` computes `seq` as `&uuid::Uuid::now_v7().to_string()[..4]`.",
          "This yields only 4 hex chars (65,536 possibilities) per prefix/year namespace, which is too small for durable immutable record IDs."
        ],
        "suggestion": "Use the full UUID (or at least a much longer suffix) in `RecordHeader::new`, and add a regression test that generates many IDs and asserts uniqueness under load-like counts.",
