    "review::.::holistic::api_surface_coherence::dispatch_action_overloads::743f9a64": {
      "id": "review::.::holistic::api_surface_coherence::dispatch_action_overloads::743f9a64",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "The ServerState dispatch API surface has three overlapping dispatch methods with inconsistent parameter styles: dispatch(DispatchCommand), dispatch_tenant_action(6 positional params), and the deprecated dispatch_action(4 positional params).",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/dispatch/mod.rs"
        ],
        "evidence": [
          "dispatch(cmd: DispatchCommand) \u2014 preferred entry point with command struct",
          "dispatch_tenant_action(tenant, entity_type, entity_id, action, params, agent_ctx) \u2014 6 positional params, not deprecated",
          "dispatch_action(entity_type, entity_id, action, params) \u2014 4 positional params, deprecated",
          "dispatch_bound_action has 11 parameters with #[allow(clippy::too_many_arguments)]",
          "authorize method has 3 different signatures across 3 files"
        ],
        "suggestion": "Deprecate dispatch_tenant_action in favor of the DispatchCommand pattern. Apply the same struct-based approach to dispatch_bound_action. Having three active dispatch entry points creates confusion about which to use.",
        "reasoning": ""
      },
