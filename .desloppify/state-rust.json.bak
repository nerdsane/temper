      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "low",
      "summary": "Tests in temper-evolution/src/store.rs use chrono::Utc::now() directly instead of sim_now(), which violates the DST principle even in test code. While this store is deprecated, the pattern could be copied to new code.",
      "detail": {
        "holistic": true,
        "dimension": "test_strategy",
        "related_files": [
          "crates/temper-evolution/src/store.rs"
        ],
        "evidence": [
