    "review::.::holistic::high_level_elegance::evolution_pipeline_god_module::5afbb1a5": {
      "id": "review::.::holistic::high_level_elegance::evolution_pipeline_god_module::5afbb1a5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "One module owns multiple evolution domains and policy heuristics.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "`insight_generator.rs` implements insight ranking, unmet-intent lifecycle inference, feature-request generation, dedup-key parsing, and error taxonomy in one file (lines 48-235, 241-311, 336-402, 318-329, 414-429).",
          "The API layer in `records_list.rs` separately re-shapes persisted evolution records/insights (lines 30-52, 92-109), so evolution behavior is split between generation policy and response-shaping policy without a clear service boundary."
        ],
        "suggestion": "Split evolution into dedicated modules/services (for example `insights`, `unmet_intents`, `feature_requests`) behind a small `EvolutionQueryService`/`EvolutionAnalysisService` interface used by observe handlers; keep classification/error taxonomy in shared typed policy modules to avoid policy scattering.",
        "reasoning": ""
