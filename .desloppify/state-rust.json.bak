      "id": "review::.::holistic::abstraction_fitness::indirection_hotspots_operations_rs::c5fcd83b",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "crates/temper-server/src/observe/evolution/operations.rs has max chain depth 4 with 29 chained calls, indicating deep indirection through helper layers for what are essentially CRUD operations on evolution records.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-server/src/observe/evolution/operations.rs",
