    "review::.::holistic::abstraction_fitness::dispatch_wrapper_pyramid::16cd0ea4": {
      "id": "review::.::holistic::abstraction_fitness::dispatch_wrapper_pyramid::16cd0ea4",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Dispatch and actor-lookup APIs use stacked pass-through wrappers that obscure the true control point.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/entity_ops.rs"
        ],
        "evidence": [
          "`dispatch_action` only injects default tenant/context then forwards to `dispatch_tenant_action` (`actions.rs:16-32`), which forwards to `dispatch_tenant_action_ext` (`:39-60`), which mainly forwards to `dispatch_tenant_action_core` (`:64-85`).",
          "`get_or_spawn_actor` and `get_or_spawn_tenant_actor` only forward defaults to `get_or_spawn_tenant_actor_with_fields` (`entity_ops.rs:72-104`)."
        ],
        "suggestion": "Collapse these into a single canonical entry point per concern plus narrowly scoped convenience constructors, and move defaulting to typed option builders so behavior/policy is explicit at call sites.",
        "reasoning": ""
      },
