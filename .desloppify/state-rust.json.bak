    "review::.::holistic::naming_quality::misleading_permissive_engine_name::4ca5ef29": {
      "id": "review::.::holistic::naming_quality::misleading_permissive_engine_name::4ca5ef29",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "`permissive` name contradicts deny-by-default behavior",
      "detail": {
        "holistic": true,
        "dimension": "naming_quality",
        "related_files": [
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/wasm_authz_gate.rs"
        ],
        "evidence": [
          "`AuthzEngine::permissive()` creates `PolicySet::new()` (`engine.rs:56-60`), and tests confirm this denies by default (`engine.rs:302-310`).",
          "In WASM authz, `PermissiveWasmAuthzGate` is true allow-all (`wasm_authz_gate.rs:104-121`), making the `permissive` engine name semantically inverted."
        ],
        "suggestion": "Rename `AuthzEngine::permissive` to an accurate term like `empty_policy_set`/`default_deny`, and update call sites/tests to remove security-behavior ambiguity.",
        "reasoning": ""
      },
