    "review::.::holistic::cross_module_architecture::missing_persistence_boundary_for_backends::124e179e": {
      "id": "review::.::holistic::cross_module_architecture::missing_persistence_boundary_for_backends::124e179e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Postgres/Turso behavior is duplicated in callers instead of hidden behind a backend boundary.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "storage.rs maintains separate near-mirror functions for loading and upserting specs across Postgres and Turso (lines 77-128 vs 472-499, and 212-294 vs 297-369).",
          "records_list.rs directly assumes Turso through `persistent_store()` and returns fallback empty payloads when absent (lines 24-27, 72-80, 89-90, 123-127), reinforcing backend policy in handlers instead of a shared repository contract."
        ],
        "suggestion": "Introduce a single persistence/repository trait for evolution/spec read-write operations and inject an implementation into server/CLI startup; move backend-specific SQL/store calls into adapter modules so handlers and serve orchestration call one interface regardless of backend.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-05T19:56:00+00:00",
