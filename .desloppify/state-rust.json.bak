    "review::.::holistic::error_consistency::mixed-string-and-typed-errors-in-dispatch::1bbe4adb": {
      "id": "review::.::holistic::error_consistency::mixed-string-and-typed-errors-in-dispatch::1bbe4adb",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "The dispatch chain mixes typed DispatchError with bare String errors. dispatch() returns Result<EntityResponse, String> despite DispatchError existing, and dispatch_tenant_action_core returns Result<_, DispatchError> but the outer layer maps it back to String via .map_err(|e| e.to_string()).",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/dispatch/mod.rs"
        ],
        "evidence": [
          "actions.rs line 28: `pub async fn dispatch(&self, cmd: DispatchCommand<'_>) -> Result<EntityResponse, String>`",
          "actions.rs line 40: `.map_err(|e| e.to_string())?` -- converts DispatchError back to String, losing structure",
          "mod.rs line 52-70: DispatchError has three typed variants but callers receive String"
        ],
        "suggestion": "Change dispatch() and dispatch_tenant_action() to return Result<_, DispatchError> to preserve the structured error context all the way to the HTTP boundary where it can be mapped to appropriate status codes.",
        "reasoning": ""
      },
