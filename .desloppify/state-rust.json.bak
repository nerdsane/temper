    "review::.::holistic::authorization_consistency::spec_submission_authz_split_brain::d13e32a5": {
      "id": "review::.::holistic::authorization_consistency::spec_submission_authz_split_brain::d13e32a5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "`load-inline` is Cedar-gated but sibling `load-dir` path is not.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/api.rs",
          "crates/temper-server/src/observe/specs/load_inline.rs",
          "crates/temper-server/src/observe/specs/load_dir.rs"
        ],
        "evidence": [
          "`/api/specs/load-inline` runs `authorize_with_context(..., \"submit_specs\", \"SpecRegistry\", ...)` (`load_inline.rs:20-58`).",
          "`/api/specs/load-dir` handler signature has no headers/context and performs no Cedar check (`load_dir.rs:25-29`).",
          "Both endpoints are mounted as peer management routes (`api.rs:42-48`)."
        ],
        "suggestion": "Make both spec ingestion paths pass through the same authz gate (ideally shared pre-handler middleware/helper), or funnel `load-dir` through `load-inline` authorization logic before any registry/persistence mutation.",
        "reasoning": ""
      },
