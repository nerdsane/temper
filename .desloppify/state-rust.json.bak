    "review::.::holistic::contract_coherence::dispatch_error_type_inconsistency::0f70c2e2": {
      "id": "review::.::holistic::contract_coherence::dispatch_error_type_inconsistency::0f70c2e2",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Dispatch methods return Result<EntityResponse, String> with bare string errors, while the codebase has a DispatchError enum defined but not consistently used at the public dispatch boundary.",
      "detail": {
        "holistic": true,
        "dimension": "contract_coherence",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/dispatch/mod.rs"
        ],
        "evidence": [
          "dispatch() returns Result<EntityResponse, String> after .map_err(|e| e.to_string()) on DispatchError",
          "dispatch_tenant_action returns Result<EntityResponse, String>",
          "dispatch_wasm_integrations_internal returns Result<Option<EntityResponse>, String>",
          "DispatchError exists but is converted to String at the boundary, losing error type information"
        ],
        "suggestion": "Propagate DispatchError through the public API instead of converting to String. Callers that need String can call .to_string() themselves. This preserves error categorization for callers that need to handle specific failure modes.",
        "reasoning": ""
      },
