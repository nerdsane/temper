    "review::.::holistic::cross_module_architecture::backend_orchestration_leaks_into_entrypoints::426a688e": {
      "id": "review::.::holistic::cross_module_architecture::backend_orchestration_leaks_into_entrypoints::426a688e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Storage-specific orchestration is embedded in entrypoint modules instead of behind a backend-neutral boundary.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "crates/temper-cli/src/serve/storage.rs:39-59 runs connection + migrations + evolution table migration in one function, binding startup behavior to Postgres implementation details.",
          "crates/temper-cli/src/serve/storage.rs:212-368 and 297-369 repeat backend-specific load/rehydration code paths instead of one shared restore workflow.",
          "crates/temper-server/src/observe/evolution/records_list.rs:24-27 and 89-90 call Turso-specific APIs directly from handlers (`list_evolution_records`, `list_ranked_insights`), so HTTP layer is coupled to one concrete persistence API."
        ],
        "suggestion": "Introduce a small persistence facade trait for evolution/spec read-write and migration hooks; make CLI serve startup and observe handlers depend on that facade so backend branching and migration sequencing live in one backend adapter layer.",
        "reasoning": ""
      },
