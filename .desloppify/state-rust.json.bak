      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Handlers silently infer tenant when headers are missing, causing inconsistent and risky tenant scoping.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/odata/common.rs",
          "crates/temper-server/src/api.rs",
          "crates/temper-server/src/observe/entities.rs"
        ],
        "evidence": [
          "`extract_tenant` falls back to first registered tenant, then `TenantId::default()` if header is absent.",
          "`handle_authorize`, `handle_audit`, and `handle_repl` default tenant to `default` when `x-tenant-id` is missing.",
          "Some handlers use inferred tenant while others use path tenant or no tenant filter, producing inconsistent authorization scope behavior."
        ],
        "suggestion": "Make tenant identity explicit and required on external requests, reject missing/invalid tenant headers, and centralize tenant resolution so all route families share the same fail-closed behavior.",
