    "review::.::holistic::incomplete_migration::evolution-store-deprecated-but-active::39042f4f": {
      "id": "review::.::holistic::incomplete_migration::evolution-store-deprecated-but-active::39042f4f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "temper-evolution RecordStore is explicitly deprecated but still used and has HashMap instead of BTreeMap",
      "detail": {
        "holistic": true,
        "dimension": "incomplete_migration",
        "related_files": [
          "crates/temper-evolution/src/store.rs"
        ],
        "evidence": [
          "The module doc (line 7) states: 'Deprecated: Evolution records are now managed as IOA entities in the temper-system tenant (ADR-0025). This store is retained for backward compatibility during migration.' Yet it uses HashMap (line 11) instead of BTreeMap, violating the codebase deterministic simulation convention. The store is also still cloneable and exported via pub use in lib.rs (line 27). No deprecation attributes are applied to the type or its methods."
        ],
        "suggestion": "Either remove the deprecated RecordStore entirely if migration to IOA entities is complete, or apply #[deprecated] attributes to its public API and switch HashMap to BTreeMap for DST compliance while it remains.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
