    "review::.::holistic::cross_module_architecture::serverstate_service_locator_spread::7fb0d030": {
      "id": "review::.::holistic::cross_module_architecture::serverstate_service_locator_spread::7fb0d030",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Broad `ServerState` access pattern creates implicit cross-module dependencies.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-server/src/events.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs",
          "crates/temper-server/src/state/dispatch_blocking.rs"
        ],
        "evidence": [
          "SSE handler directly consumes auth + event bus from full state (`events.rs:49-51`), evolution handlers consume auth + persistence from full state (`records_list.rs:26-30`, `:94-97`), and dispatch blocking consumes internal dispatch engine via full state impl (`dispatch_blocking.rs:24-49`).",
          "These modules depend on a single broad state carrier instead of narrow capability interfaces, so internal state changes can ripple across unrelated endpoints and dispatch paths."
        ],
        "suggestion": "Slice `ServerState` into capability traits/typed subcontexts (e.g., `EventStreamContext`, `EvolutionStoreContext`, `WasmDispatchContext`) and inject only required capabilities into each module.",
        "reasoning": ""
      },
