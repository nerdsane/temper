    "review::.::holistic::low_level_elegance::dispatch_core_multi_responsibility::c6cb0d82": {
      "id": "review::.::holistic::low_level_elegance::dispatch_core_multi_responsibility::c6cb0d82",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Core dispatch function combines too many responsibilities, making local reasoning brittle.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "crates/temper-server/src/state/dispatch/actions.rs",
          "crates/temper-server/src/state/entity_ops.rs"
        ],
        "evidence": [
          "`dispatch_tenant_action_core` handles actor dispatch, trajectory persistence, SSE event broadcast, cache updates, webhook scheduling, integration dispatch, and spawn dispatch in one routine (`actions.rs:169-385`).",
          "Entity lifecycle helpers in `entity_ops.rs` depend on this monolithic behavior (`entity_ops.rs:324-353`), increasing coupling to side-effect order."
        ],
        "suggestion": "Split dispatch into staged helpers (execute action, persist telemetry, emit/broadcast side effects, async integration hooks) with explicit stage outputs to reduce control-flow density and ordering bugs.",
        "reasoning": ""
      },
