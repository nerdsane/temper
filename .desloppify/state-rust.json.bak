    "review::.::holistic::cross_module_architecture::serverstate_as_hub_for_unrelated_flows::0dce29d4": {
      "id": "review::.::holistic::cross_module_architecture::serverstate_as_hub_for_unrelated_flows::0dce29d4",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "`ServerState` is used as a broad integration hub across unrelated concerns, increasing coupling.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-server/src/events.rs",
          "crates/temper-server/src/state/dispatch_blocking.rs"
        ],
        "evidence": [
          "crates/temper-server/src/events.rs:43-58 directly subscribes to `state.event_tx`, binding SSE transport to internal state field layout.",
          "crates/temper-server/src/state/dispatch_blocking.rs:24-50 extends `impl ServerState` with inline WASM orchestration and forwards an 8-field request bag to internal dispatch.",
          "Both modules attach dissimilar concerns (SSE transport and integration dispatch choreography) to the same shared state object, signaling god-object growth at subsystem boundaries."
        ],
        "suggestion": "Extract focused service interfaces (for example `EventStreamService` and `IntegrationDispatchService`) owned by `ServerState` but consumed by handlers/modules via narrow traits, so boundary changes don\u2019t require touching the global state surface.",
        "reasoning": ""
      },
      "status": "auto_resolved",
