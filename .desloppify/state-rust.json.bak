    "review::.::holistic::authorization_consistency::header_spoofed_system_bypass::87647fea": {
      "id": "review::.::holistic::authorization_consistency::header_spoofed_system_bypass::87647fea",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Authorization can be bypassed by spoofing `x-temper-principal-kind: system` in request headers.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-authz/src/context.rs",
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/state/entity_ops.rs"
        ],
        "evidence": [
          "`SecurityContext::from_headers` maps `x-temper-principal-kind` directly to `PrincipalKind`, including `System`, with no token verification.",
          "`AuthzEngine::authorize_or_bypass` returns `Allow` for any `System` principal before Cedar policy evaluation.",
          "`ServerState::authorize` builds context from raw headers (`SecurityContext::from_headers(headers)`), so user-controlled headers can reach bypass logic."
        ],
        "suggestion": "Remove `System` selection from externally sourced headers. Derive system principals only from trusted server-internal call paths (e.g., signed service identity or explicit internal constructor), and reject/ignore `x-temper-principal-kind=system` at HTTP boundaries.",
        "reasoning": ""
      },
      "status": "auto_resolved",
