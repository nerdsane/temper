    "review::.::holistic::api_surface_coherence::decision_endpoint_return_type_inconsistency::dbadc486": {
      "id": "review::.::holistic::api_surface_coherence::decision_endpoint_return_type_inconsistency::dbadc486",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Decision handlers use impl IntoResponse while observe handlers use Result<Json<Value>, StatusCode>",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "crates/temper-server/src/api/decisions.rs",
          "crates/temper-server/src/observe/evolution/operations.rs",
          "crates/temper-server/src/observe/specs.rs"
        ],
        "evidence": [
          "handle_list_decisions returns impl IntoResponse",
          "handle_approve_decision returns impl IntoResponse",
          "handle_list_evolution_records returns Result<Json<Value>, StatusCode>",
          "handle_list_specs returns Result<Json<Value>, StatusCode>",
          "The two patterns have different error surface areas and make it harder to reason about what status codes an endpoint can return"
        ],
        "suggestion": "Standardize on Result<Json<Value>, StatusCode> for endpoints that can only fail with a status code, or define a typed error enum. Reserve impl IntoResponse for endpoints that genuinely need mixed response types (e.g., SSE streams).",
        "reasoning": ""
      },
      "status": "wontfix",
      "note": "Architectural observation \u2014 tracked",
