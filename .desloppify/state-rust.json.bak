      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "TursoEventStore is a multi-domain god abstraction with weak cohesion",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-store-turso/src/store.rs",
          "crates/temper-server/src/observe/evolution/operations.rs",
          "crates/temper-cli/src/serve/mod.rs"
        ],
        "evidence": [
          "`TursoEventStore` contains event append/read/snapshot plus spec verification, trajectory analytics, feature request CRUD, evolution records, decisions, constraints, wasm modules/invocations, and policy storage in one type.",
          "Callers in server/CLI consume these cross-domain methods directly, so a single storage abstraction owns many unrelated contracts."
        ],
        "suggestion": "Split Turso storage into domain-focused repository traits (event_store, spec_store, evolution_store, wasm_store, policy_store) and compose them behind a small runtime-facing facade.",
        "reasoning": ""
      },
