    "review::.::holistic::authorization_consistency::system_principal_default_creates_header_omission_bypass::9b8ee277": {
      "id": "review::.::holistic::authorization_consistency::system_principal_default_creates_header_omission_bypass::9b8ee277",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Missing principal headers default to `System`, which is unconditionally allowed by authz bypass logic.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-authz/src/context.rs",
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/api.rs"
        ],
        "evidence": [
          "`SecurityContext::from_headers` initializes `kind` as `PrincipalKind::System` when headers are absent/unknown.",
          "`AuthzEngine::authorize_or_bypass` immediately returns `Allow` for `System` principals.",
          "API handlers build security context directly from request headers (`security_context_from_headers`) and then rely on `authorize_with_context`, so omitted identity headers can inherit bypass semantics."
        ],
        "suggestion": "Change default principal to non-privileged (for example `Agent`/`Customer` anonymous), reserve `System` for internal trusted call paths only, and reject external requests that do not present required identity headers.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-05T19:41:42+00:00",
