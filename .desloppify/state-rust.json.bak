    "review::.::holistic::design_coherence::api_policy_decision_flow_duplication::76e9a352": {
      "id": "review::.::holistic::design_coherence::api_policy_decision_flow_duplication::76e9a352",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Decision and policy APIs duplicate multi-step authorization+policy-update orchestration instead of sharing a domain service.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "crates/temper-server/src/api/decisions.rs",
          "crates/temper-server/src/api/policies.rs",
          "crates/temper-server/src/authz_helpers.rs"
        ],
        "evidence": [
          "`handle_approve_decision` (`decisions.rs:62+`) performs authz, decision retrieval/validation, policy text generation, engine reload, policy persistence, decision persistence, and evolution record write in one handler.",
          "`handle_put_policies` (`policies.rs:33+`) and `handle_add_policy_rule` (`:135+`) repeat authz denial shaping, JSON validation, combined-policy recomputation, and `reload_policies` orchestration.",
          "Both endpoints reconstruct combined policy text independently (`decisions.rs:131-156`, `policies.rs:95-107`, `:197-219`), creating repeated algorithm paths with different edge-case handling."
        ],
        "suggestion": "Extract a shared `PolicyMutationService` (authorize \u2192 prepare mutation \u2192 validate/reload \u2192 persist) used by decisions and policies handlers, and centralize denial response construction in one helper to enforce a single mutation workflow.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-03-05T22:14:24+00:00",
