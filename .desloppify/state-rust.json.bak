    "review::.::holistic::cross_module_architecture::boundary_leak_cli_api_to_storage::0389819e": {
      "id": "review::.::holistic::cross_module_architecture::boundary_leak_cli_api_to_storage::0389819e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "CLI and API layers directly depend on persistence and server internals, creating a broad coupling hotspot.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "storage.rs imports `temper_server::event_store::ServerEventStore` and `temper_server::registry::*` and performs registry rehydration directly (lines 9-12, 272-289, 347-364).",
          "records_list.rs handlers directly call `state.persistent_store()` and merge raw `r.data` JSON into response objects (lines 24-49, 89-107), bypassing a domain service boundary."
        ],
        "suggestion": "Introduce a storage-agnostic application service trait (e.g., evolution/spec read-model service) in a neutral crate and move row-to-domain/API mapping there; make CLI and HTTP handlers depend on that trait instead of concrete store/server internals.",
        "reasoning": ""
