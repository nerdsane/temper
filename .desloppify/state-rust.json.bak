            "crates/temper-cli/src/serve/storage.rs"
          ],
          "evidence": [
            "authz_helpers.rs line 87: eprintln!('Warning: failed to persist pending decision') in persistence error path",
            "api.rs lines 739, 754: eprintln! for warning messages in critical paths",
            "temper-mcp/src/runtime.rs lines 384, 414: eprintln! for server output",
            "storage.rs: println!('Connecting to Postgres...') and println!('Postgres connected, migrations applied.') instead of tracing::info!",
            "156+ files use tracing::warn!, tracing::error!, tracing::info! consistently -- these outliers break the pattern"
          ],
          "suggestion": "Replace all eprintln! and println! calls in persistence/server paths with tracing::warn! or tracing::info!. CLI user-facing output is acceptable as println!, but server-side error paths should use structured tracing for consistency and observability.",
          "reasoning": ""
        }
      }
    },
    "review::.::holistic::type_safety::bare_string_domain_types::ecc7e684": {
      "id": "review::.::holistic::type_safety::bare_string_domain_types::ecc7e684",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Entity types, action names, and status values are passed as bare String/&str throughout the codebase, losing compile-time domain safety",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "crates/temper-server/src/reaction/types.rs",
          "crates/temper-server/src/entity_actor/types.rs",
          "crates/temper-jit/src/table/types.rs",
          "crates/temper-server/src/reaction/registry.rs",
          "crates/temper-server/src/eventual_invariants.rs"
        ],
        "evidence": [
          "ReactionTrigger.entity_type: String and ReactionTarget.entity_type: String -- no newtype protection",
          "TransitionTable.entity_name: String -- core domain type as bare string",
          "EntityState.entity_type: String, status: String, action: String -- all bare strings",
          "TenantId is a well-designed newtype but entity_type and action are bare String everywhere",
          "reaction/registry.rs uses format!('{}:{}', entity_type, action) for key construction -- string concatenation for compound keys is error-prone",
          "eventual_invariants.rs stores tenant as String instead of TenantId, bypassing TenantId validation"
        ],
        "suggestion": "Introduce newtypes for EntityType and ActionName similar to the existing TenantId pattern. This provides compile-time protection against mixing entity types with action names or status values. Start with the most used types (EntityType, ActionName) and gradually adopt across the codebase.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-06T00:49:14+00:00",
