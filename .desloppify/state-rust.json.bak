    "review::.::holistic::cross_module_architecture::duplicated_backend_restore_pipeline::c2b4e214": {
      "id": "review::.::holistic::cross_module_architecture::duplicated_backend_restore_pipeline::c2b4e214",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Postgres and Turso registry restore flows are duplicated, causing architecture drift risk.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/state/dispatch_blocking.rs"
        ],
        "evidence": [
          "`load_registry_from_postgres` and `load_registry_from_turso` duplicate grouping, CSDL parsing, tenant registration, and verification-status restoration logic almost line-for-line (`storage.rs:212-294` vs `296-369`).",
          "This duplication sits on critical startup state used by downstream runtime paths (including blocking dispatch over `ServerState` in `dispatch_blocking.rs:24-49`), so divergence in one restore path can silently alter runtime behavior per backend."
        ],
        "suggestion": "Extract a backend-agnostic restore pipeline that accepts a normalized row/constraint iterator and shared mapping callbacks; keep backend code limited to data fetch and row adaptation.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
