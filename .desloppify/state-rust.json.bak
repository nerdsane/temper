    "review::.::holistic::contract_coherence::auth_contract_allows_implicit_privilege::4c4986a2": {
      "id": "review::.::holistic::contract_coherence::auth_contract_allows_implicit_privilege::4c4986a2",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Security context contract grants privileged semantics on missing headers",
      "detail": {
        "holistic": true,
        "dimension": "contract_coherence",
        "related_files": [
          "crates/temper-authz/src/context.rs",
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/api.rs"
        ],
        "evidence": [
          "Context construction from headers treats unknown principal kind as `System` (`context.rs:64-68`).",
          "Auth engine defines `System` as unconditional bypass (`engine.rs:212-226`).",
          "API handlers commonly build context directly from request headers (`api.rs:341`, `443`, `1053`) without mandatory identity presence checks."
        ],
        "suggestion": "Make header-derived contexts unprivileged by default and require explicit trusted construction for system-level contexts; enforce presence/validation of principal headers at API boundary.",
        "reasoning": ""
      },
