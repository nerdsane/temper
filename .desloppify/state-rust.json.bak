      "tier": 3,
      "confidence": "high",
      "summary": "Webhook auth headers are bound to environment at startup and silently blank on missing vars",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "crates/temper-server/src/webhooks.rs",
          "crates/temper-cli/src/serve/mod.rs"
        ],
        "evidence": [
          "Webhook config expansion resolves `${ENV_VAR}` once in `from_toml` and substitutes unknown variables with empty string (`webhooks.rs:72-85,176-189`).",
          "Dispatcher is created once during `temper serve` startup and reused (`serve/mod.rs:194-218`), so secret availability/rotation after bootstrap is not reflected."
