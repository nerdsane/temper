    "review::.::holistic::abstraction_fitness::panic_based_public_apis::4162a564": {
      "id": "review::.::holistic::abstraction_fitness::panic_based_public_apis::4162a564",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Public convenience APIs mask fallible work behind panics instead of typed errors",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-jit/src/table/builder.rs",
          "crates/temper-server/src/registry.rs",
          "crates/temper-platform/src/bootstrap.rs",
          "crates/temper-server/src/entity_actor/sim_handler.rs"
        ],
        "evidence": [
          "`TransitionTable::from_ioa_source` panics on parse failure via `expect` (builder.rs:15-18).",
          "`SpecRegistry::register_tenant*` wrappers panic on `try_` failures (`unwrap_or_else(|e| panic!(...))`) instead of surfacing `Result` (registry.rs:236-252,274-292).",
          "Bootstrap flow uses `unwrap_or_else(panic!)` and `assert!` for parse/verification failures, making startup failure paths non-recoverable and untyped (bootstrap.rs:87-107).",
          "`EntityActorHandler::with_ioa_invariants` also panics on parse via `expect` (sim_handler.rs:73-76)."
        ],
        "suggestion": "Make fallible constructors and registration/bootstrap entry points return `Result` all the way up; keep panic-only wrappers private (or remove them) so interface contracts stay explicit and composable.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-03-05T22:14:24+00:00",
      "last_seen": "2026-03-05T22:14:24+00:00",
