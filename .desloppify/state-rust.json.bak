    "review::.::holistic::high_level_elegance::observe-feature-gating::51f4bd6a": {
      "id": "review::.::holistic::high_level_elegance::observe-feature-gating::51f4bd6a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "The observe and sentinel modules are behind #[cfg(feature = \"observe\")] in temper-server lib.rs, but the ServerState struct and its methods reference observe-related types unconditionally. This creates a partial feature gate that doesn't cleanly separate the concern.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "crates/temper-server/src/lib.rs",
