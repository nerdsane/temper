      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Test files follow two different conventions: some are _test.rs files within src/ (mod_test.rs, router_test.rs, lib_tests.rs) while others are in the tests/ directory. For temper-server, both patterns coexist.",
      "detail": {
        "holistic": true,
        "dimension": "convention_outlier",
        "related_files": [
