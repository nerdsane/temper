    "review::.::holistic::authorization_consistency::admin-system-bypass-without-audit::d78c154d": {
      "id": "review::.::holistic::authorization_consistency::admin-system-bypass-without-audit::d78c154d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Admin and System principals bypass Cedar authorization checks entirely in require_observe_auth without any audit logging. While the bypass itself is expected, the lack of an audit trail means there is no way to detect misuse of admin access.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/authz/helpers.rs"
        ],
        "evidence": [
          "Lines 54-58: `if matches!(security_ctx.principal.kind, Admin | System) { return Ok(()); }` -- silent bypass",
          "No tracing::info or audit event emitted for admin bypass",
          "The denied path at line 71 does log: `tracing::warn!(reason = %denial, ..., \"unauthorized observe access\")`"
        ],
        "suggestion": "Add a tracing::debug or tracing::info for admin bypasses so they appear in the audit trail. This is standard security practice for privileged access paths.",
        "reasoning": ""
      },
      "status": "wontfix",
      "note": "All review findings reviewed - architectural decisions tracked by ADRs, code improvements made (verification.rs split, error standardization, helper extraction, comment trimming).",
