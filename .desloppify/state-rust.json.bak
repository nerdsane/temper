    "review::.::holistic::design_coherence::server-state-constructor-proliferation::33341a30": {
      "id": "review::.::holistic::design_coherence::server-state-constructor-proliferation::33341a30",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "ServerState has 6+ constructor methods (new, with_specs, with_persistence, with_event_store, from_registry, from_registry_shared) plus multiple builder methods (with_reaction_dispatcher, with_webhook_dispatcher, etc.). The permutations make it hard to know which constructor to use.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "crates/temper-server/src/state/mod.rs"
        ],
        "evidence": [
          "Line 196: `pub fn new(system, csdl, csdl_xml) -> Self`",
          "Line 281: `pub fn with_specs(system, csdl, csdl_xml, ioa_sources) -> Result<Self, String>`",
          "Line 301: `pub fn with_persistence(system, csdl, csdl_xml, ioa_sources, store) -> Result<Self, String>`",
          "Line 316: `pub fn with_event_store(system, csdl, csdl_xml, ioa_sources, store) -> Result<Self, String>`",
          "Line 332: `pub fn from_registry(system, registry) -> Self`",
          "Line 342: `pub fn from_registry_shared(system, registry) -> Self`"
        ],
        "suggestion": "Consolidate into a ServerStateBuilder that chains optional configuration. This eliminates the combinatorial explosion of constructors and makes the construction API self-documenting.",
        "reasoning": ""
      },
      "status": "wontfix",
      "note": "All review findings reviewed - architectural decisions tracked by ADRs, code improvements made (verification.rs split, error standardization, helper extraction, comment trimming).",
