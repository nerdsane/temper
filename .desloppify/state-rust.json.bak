    "review::.::holistic::type_safety::type-safety-string-status-state-machine::761cdc96": {
      "id": "review::.::holistic::type_safety::type-safety-string-status-state-machine::761cdc96",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "State machine status values use bare String throughout EntityState, TransitionTable, and EntityEvent, losing compile-time guarantees about valid states",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "crates/temper-server/src/entity_actor/types.rs",
          "crates/temper-jit/src/table/types.rs"
        ],
        "evidence": [
          "EntityState.status: String -- any string is accepted",
          "TransitionTable.states: Vec<String> -- valid states are runtime-only knowledge",
          "EntityEvent.from_status: String, to_status: String -- no compile-time constraint"
        ],
        "suggestion": "This is a deliberate design choice for a spec-driven platform where entity types are defined at runtime. Consider a newtype wrapper (e.g., StateId(String)) with validation at construction boundaries to catch invalid state strings earlier.",
