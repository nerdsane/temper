    "review::.::holistic::low_level_elegance::record_id_entropy_too_low::10b0ebb1": {
      "id": "review::.::holistic::low_level_elegance::record_id_entropy_too_low::10b0ebb1",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Evolution record ID generation uses too little entropy, making collisions likely in real workloads.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "crates/temper-evolution/src/records.rs",
          "crates/temper-evolution/src/lib.rs"
        ],
        "evidence": [
          "`RecordHeader::new` uses `let seq = &uuid::Uuid::now_v7().to_string()[..4];` which keeps only 4 hex chars (~16 bits).",
          "IDs are formatted as `<prefix>-<year>-<seq>`, so high-throughput creation within the same year can collide and break traceability assumptions for immutable record chains."
        ],
        "suggestion": "Use full UUID v7 (or at least a substantially longer suffix) for record IDs, and add collision-focused tests/property tests for high-volume ID generation.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
