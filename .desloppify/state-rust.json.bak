    "review::.::holistic::authorization_consistency::spoofable_system_principal_header::8f3d947b": {
      "id": "review::.::holistic::authorization_consistency::spoofable_system_principal_header::8f3d947b",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Request headers can self-assign `System` principal and bypass all authorization checks",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-authz/src/context.rs",
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/authz_helpers.rs"
        ],
        "evidence": [
          "`SecurityContext::from_headers` maps `x-temper-principal-kind=system` to `PrincipalKind::System` (`context.rs:65-74`).",
          "`authorize_or_bypass` returns `Allow` for any system principal without policy evaluation (`engine.rs:217-229`).",
          "Server request path builds security context directly from inbound `x-temper-*` headers (`authz_helpers.rs:17-40`) with no in-process trust-boundary guard."
        ],
        "suggestion": "Remove acceptance of `system` from external header parsing and reserve system principals for trusted construction (`SecurityContext::system()` on internal call paths only). Add a server-side middleware that strips or rejects privileged `x-temper-*` identity headers from untrusted requests, and add tests proving external requests cannot obtain system/admin bypass by header spoofing.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-03-05T22:14:24+00:00",
      "last_seen": "2026-03-05T22:14:24+00:00",
      "resolved_at": "2026-03-06T01:38:00+00:00",
