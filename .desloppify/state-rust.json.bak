      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Evolution records are written to both the deprecated in-memory RecordStore AND the IOA entity system AND Turso. This triple-write pattern (acknowledged in ADR-0025 comments) creates an unclear source of truth.",
      "detail": {
        "holistic": true,
        "dimension": "incomplete_migration",
        "related_files": [
          "crates/temper-server/src/observe/evolution/operations.rs",
          "crates/temper-server/src/state/mod.rs"
