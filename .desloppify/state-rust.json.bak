    "review::.::holistic::high_level_elegance::verification_gate_semantics_not_preserved_in_insights::08d40fee": {
      "id": "review::.::holistic::high_level_elegance::verification_gate_semantics_not_preserved_in_insights::08d40fee",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Insight pipeline treats SubmitSpec success as resolution, bypassing stated verification/approval governance contract",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "README.md",
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "README states every change is gated by verification cascade and presents OPADI chain integrity as core governance behavior (README.md:111, README.md:154, README.md:219).",
          "Unmet-intent resolution is inferred from any successful SubmitSpec event by entity_type, with no check for verification outcome, decision status, or deployment success (crates/temper-server/src/insight_generator.rs:112-125, :250-252).",
          "Records API exposes status fields as governance truth to consumers (crates/temper-server/src/observe/evolution/records_list.rs:35-38), so premature 'resolved' inference creates top-level contract dishonesty."
        ],
        "suggestion": "Resolve unmet intents from verified governance artifacts (e.g., decision approved + verification passed + spec active) rather than SubmitSpec success heuristics, and centralize this lifecycle mapping in one domain component used by both insight generation and observe views.",
        "reasoning": ""
      },
