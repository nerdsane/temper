    "review::.::holistic::type_safety::string-typed-status-enums::4ac4f366": {
      "id": "review::.::holistic::type_safety::string-typed-status-enums::4ac4f366",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "AgentProgressEvent and DesignTimeEvent use String fields for kind/status discriminators rather than enums. While acceptable for SSE serialization, these accept arbitrary strings at construction sites with no compile-time validation.",
