    "review::.::holistic::cross_module_architecture::api_router_reaches_into_observe::68467222": {
      "id": "review::.::holistic::cross_module_architecture::api_router_reaches_into_observe::68467222",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "The /api router directly calls handlers defined in the /observe module tree",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-server/src/api/mod.rs",
          "crates/temper-server/src/observe/specs.rs",
          "crates/temper-server/src/observe/wasm.rs",
          "crates/temper-server/src/observe/evolution.rs"
        ],
        "evidence": [
          "api/mod.rs line 37: post(crate::observe::specs::handle_load_dir)",
          "api/mod.rs line 44: post(crate::observe::wasm::upload_wasm_module)",
          "api/mod.rs line 49: post(crate::observe::evolution::handle_decide)",
          "The observe module is documented as 'read-only observation routes' (mod.rs line 136) but the api router mounts mutating endpoints from it"
        ],
        "suggestion": "Move the mutating handlers (handle_load_dir, handle_load_inline, upload_wasm_module, delete_wasm_module, handle_decide, handle_unmet_intent, handle_sentinel_check) from the observe module into the api module. This would enforce the stated boundary that observe is read-only.",
