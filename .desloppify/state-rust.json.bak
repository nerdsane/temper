    "review::.::holistic::cross_module_architecture::dual_backend_flow_duplication::3fb45426": {
      "id": "review::.::holistic::cross_module_architecture::dual_backend_flow_duplication::3fb45426",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Postgres and Turso integration paths are duplicated, creating backend drift risk across modules.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-cli/src/serve/storage.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "`load_registry_from_postgres` and `load_registry_from_turso` repeat the same tenant grouping, CSDL parse, registry registration, and status restoration flow (`storage.rs` lines ~212-369).",
          "`upsert_loaded_specs_to_postgres` and `upsert_loaded_specs_to_turso` duplicate the same spec/constraint sync policy (`storage.rs` lines ~77-128 and ~472-499).",
          "`records_list.rs` bypasses any shared backend-neutral read path and calls Turso-specific methods directly (`state.persistent_store().list_*`), reinforcing split backend behavior."
        ],
        "suggestion": "Introduce a backend-neutral persistence interface (e.g., `SpecPersistence`/`EvolutionReadStore`) and move shared restore/upsert orchestration into one implementation path; keep backend-specific code as thin adapters. Route `records_list` through that same interface instead of direct Turso calls.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-05T20:21:06+00:00",
      "last_seen": "2026-03-05T20:21:06+00:00",
      "resolved_at": "2026-03-05T20:45:05+00:00",
      "reopen_count": 0,
      "lang": "rust",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::cross_module_architecture::string_protocol_boundary_drift::835b05ad": {
      "id": "review::.::holistic::cross_module_architecture::string_protocol_boundary_drift::835b05ad",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Cross-module behavior depends on magic strings rather than typed contracts.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs",
          "crates/temper-server/src/events.rs"
        ],
        "evidence": [
          "`insight_generator.rs` derives behavior from literal action/error text (`SubmitSpec`, `EntitySetNotFound`, `Authorization denied`, `ActionNotFound`) instead of typed event/error categories.",
          "`records_list.rs` accepts raw status/type strings in query params and composes JSON using string keys directly, with no shared enum/schema boundary.",
          "`events.rs` emits a literal SSE event name (`\"state_change\"`) with no shared protocol constant across publishers/consumers."
        ],
        "suggestion": "Define shared protocol types/constants in a common domain module (action kinds, error categories, record status/type enums, SSE event names) and update handlers/generators to consume typed values instead of string matching.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-05T20:21:06+00:00",
      "last_seen": "2026-03-05T20:21:06+00:00",
      "resolved_at": "2026-03-05T20:45:05+00:00",
      "reopen_count": 0,
      "lang": "rust",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::cross_module_architecture::server_state_as_hub_module::8817b8a7": {
      "id": "review::.::holistic::cross_module_architecture::server_state_as_hub_module::8817b8a7",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "ServerState exposes low-level internals across modules, increasing coupling and blast radius.",
