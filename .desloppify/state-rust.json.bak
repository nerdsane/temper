    "review::.::holistic::abstraction_fitness::server-state-god-struct::ec7e0869": {
      "id": "review::.::holistic::abstraction_fitness::server-state-god-struct::ec7e0869",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "ServerState has 30+ public fields, all wrapped in Arc, spanning concerns from actor management to auth to WASM to evolution records. This struct serves as a shared context bag passed to every handler, and new fields are regularly appended. While Clone + Arc makes this work, the flat field list makes it hard to understand what each handler actually needs.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-server/src/state/mod.rs"
        ],
        "evidence": [
          "Lines 116-192: ServerState struct definition with 30+ pub fields",
          "Lines 215-257: new() constructor initializes all 30+ fields",
          "Lines 347-390: from_registry_shared() duplicates the same 30+ field initialization",
          "Duplicated initialization logic between new() and from_registry_shared() -- 2 constructors that must be kept in sync"
        ],
        "suggestion": "Group related fields into sub-structs (e.g., AuthzConfig, WasmConfig, EvolutionConfig, TelemetryConfig) and compose them into ServerState. This would also eliminate the duplicated initialization and make it clear which handlers depend on which subsystem.",
