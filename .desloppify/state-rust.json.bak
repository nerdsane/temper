    "review::.::holistic::authorization_consistency::rls-coverage-gap-turso-tables::f9ec12e6": {
      "id": "review::.::holistic::authorization_consistency::rls-coverage-gap-turso-tables::f9ec12e6",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Turso persistence tables (evolution_records, pending_decisions, tenant_policies, feature_requests) have no row-level security, while all Postgres tables have tenant isolation RLS policies. This creates an inconsistent trust boundary across persistence backends.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-store-postgres/src/schema.rs",
          "crates/temper-store-turso/src/schema.rs"
        ],
        "evidence": [
          "Postgres schema defines ENABLE_TENANT_RLS with tenant_isolation policies for events, snapshots, specs, trajectories, design_time_events, tenant_constraints, wasm_modules, wasm_invocation_logs, and tenant_secrets",
          "Turso schema.rs defines evolution_records, pending_decisions, tenant_policies, and feature_requests tables with tenant columns but zero RLS policy definitions",
          "Grep for 'ROW LEVEL SECURITY' or 'tenant_isolation' in temper-store-turso/src/schema.rs returns no matches",
          "The blind packet's rls_coverage.without_rls list confirms evolution_records, feature_requests, pending_decisions, and tenant_policies lack RLS"
        ],
        "suggestion": "Implement equivalent tenant isolation for Turso tables. Since Turso (libSQL) does not support Postgres-style RLS, enforce tenant scoping at the query layer by auditing all Turso queries to ensure they include a WHERE tenant = ? clause, or add an application-level middleware that validates tenant context before query execution.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-06T02:56:17+00:00",
