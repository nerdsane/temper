    "review::.::holistic::api_surface_coherence::dual_failure_channel_tool_result::941884be": {
      "id": "review::.::holistic::api_surface_coherence::dual_failure_channel_tool_result::941884be",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Tool execution API exposes two competing error channels",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "crates/temper-agent-runtime/src/tools/mod.rs",
          "crates/temper-mcp/src/error.rs"
        ],
        "evidence": [
          "`ToolRegistry::execute` returns `anyhow::Result<ToolResult>` (`tools/mod.rs:55`).",
          "`ToolResult` includes `Error(String)` (`tools/mod.rs:27-32`), so failures may be represented as either `Err(_)` or `Ok(ToolResult::Error(_))`.",
          "By contrast, MCP consolidates error propagation on `Result<T, McpError>` (`mcp/error.rs:61-63`), showing a clearer single-channel contract."
        ],
        "suggestion": "Collapse to one failure channel: either return `Result<String, ToolError>` (preferred) or return only `ToolResult` and remove outer `Result`. Introduce a typed `ToolError` enum and map it explicitly at protocol boundaries.",
        "reasoning": ""
      },
      "status": "auto_resolved",
