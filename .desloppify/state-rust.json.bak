    "review::.::holistic::authorization_consistency::missing_rls_on_tenant_tables::2b63c376": {
      "id": "review::.::holistic::authorization_consistency::missing_rls_on_tenant_tables::2b63c376",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Six tenant-scoped database tables lack Row-Level Security policies while their sibling tables have RLS enabled, creating inconsistent tenant isolation depth.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-store-postgres/src/schema.rs"
        ],
        "evidence": [
          "Tables WITH RLS: events, snapshots, specs, trajectories, design_time_events, tenant_constraints, wasm_modules, wasm_invocation_logs, tenant_secrets",
          "Tables WITHOUT RLS: evolution_records, feature_requests, pending_decisions, tenant_policies",
          "The blind packet explicitly lists these as without_rls in authorization.rls_coverage",
          "evolution_records and pending_decisions both contain tenant-scoped data per the CSDL model"
        ],
        "suggestion": "Add RLS policies for evolution_records, feature_requests, pending_decisions, and tenant_policies to match the defense-in-depth approach documented in schema.rs comments. Even if application code filters by tenant, RLS prevents cross-tenant data access from application bugs.",
        "reasoning": ""
      },
