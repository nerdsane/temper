    "review::.::holistic::cross_module_architecture::route_modules_reach_into_state_internals::7bcf544f": {
      "id": "review::.::holistic::cross_module_architecture::route_modules_reach_into_state_internals::7bcf544f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Route handlers are coupled to concrete `ServerState` internals instead of a stable event/query interface.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "crates/temper-server/src/events.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "events.rs reads `state.event_tx` directly and subscribes to a concrete broadcast channel (line 46).",
          "records_list.rs reads `state.persistent_store()` directly in both endpoints and performs direct store branching (lines 24, 89), making route modules dependent on internal state composition."
        ],
        "suggestion": "Add narrow `ServerState` facade methods (for example `subscribe_state_changes()` and `query_evolution_records(...)`) and keep transport handlers limited to HTTP translation; hide channel/store wiring in state/service modules.",
        "reasoning": ""
      },
