      "id": "review::.::holistic::abstraction_fitness::wide_param_bag_dispatch_rs::d8814d3d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "The dispatch/wasm module and sandbox/dispatch module have very high config_bag_mentions (113 and 60 respectively), indicating data is threaded through many layers via wide parameter bags rather than cohesive context objects.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-sandbox/src/dispatch.rs",
          "crates/temper-server/src/state/dispatch/wasm.rs",
          "crates/temper-server/src/state/dispatch/effects.rs"
        ],
        "evidence": [
          "temper-sandbox/src/dispatch.rs: config_bag_mentions 113",
          "temper-server/src/state/dispatch/wasm.rs: config_bag_mentions 60",
          "dispatch_temper_method takes (ctx, method, args, kwargs) where ctx itself is a wide bag",
          "dispatch_bound_action has #[allow(clippy::too_many_arguments)] with 11 parameters"
        ],
        "suggestion": "The WasmDispatchCtx pattern introduced in wasm.rs is the right direction. Apply it more broadly: consolidate the 11-parameter dispatch_bound_action into a BoundActionRequest struct, and refactor dispatch_temper_method's DispatchContext to carry fewer unrelated fields.",
        "reasoning": ""
      },
