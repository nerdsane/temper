    "review::.::holistic::authorization_consistency::implicit_tenant_fallbacks_weaken_isolation::5a7c009b": {
      "id": "review::.::holistic::authorization_consistency::implicit_tenant_fallbacks_weaken_isolation::5a7c009b",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Multiple endpoints silently choose fallback tenants when tenant identity is absent.",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/odata/common.rs",
          "crates/temper-server/src/api.rs",
          "crates/temper-server/src/observe/entities.rs"
        ],
        "evidence": [
          "`extract_tenant` falls back to first registered tenant, then `TenantId::default()` when header is missing (`odata/common.rs:13-37`).",
          "`/api/authorize`, `/api/audit`, and `/api/repl` use `x-tenant-id` with `unwrap_or(\"default\")` (`api.rs:1033-1037`, `1088-1092`, `1153-1157`).",
          "History endpoint depends on extracted tenant for actor path (`observe/entities.rs:61-65`), so fallback behavior directly affects which tenant data is accessed."
        ],
        "suggestion": "Require explicit tenant identity for tenant-scoped endpoints (reject missing header/path with 400/401), and keep fallback only for clearly documented single-tenant dev mode behind an explicit feature/env gate.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Fixed despite wontfix \u2014 disappeared from scan (was wontfix)",
      "first_seen": "2026-03-05T19:56:00+00:00",
      "last_seen": "2026-03-05T19:56:00+00:00",
