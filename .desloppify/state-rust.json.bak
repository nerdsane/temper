    "review::.::holistic::naming_quality::misleading_permissive_constructor_name::9de5c391": {
      "id": "review::.::holistic::naming_quality::misleading_permissive_constructor_name::9de5c391",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "`AuthzEngine::permissive` name contradicts deny-by-default runtime behavior",
      "detail": {
        "holistic": true,
        "dimension": "naming_quality",
        "related_files": [
          "crates/temper-authz/src/engine.rs",
          "crates/temper-server/src/wasm_authz_gate.rs"
        ],
        "evidence": [
          "`engine.rs` documents `permissive()` as creating engine with no policies that denies by default.",
          "`wasm_authz_gate.rs` has `PermissiveWasmAuthzGate` that truly allows everything, making `permissive` overloaded with opposite meanings in auth code."
        ],
        "suggestion": "Rename `AuthzEngine::permissive` to `empty_policy_set`/`deny_all_default` (with deprecation shim if needed) to align naming with behavior.",
        "reasoning": ""
