      "id": "review::.::holistic::design_coherence::wasm_dispatch_concern_overload::3323abd5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "WASM dispatch pipeline conflates execution, policy enforcement, observability, and governance side effects in one path.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "crates/temper-server/src/state/dispatch/wasm.rs",
          "crates/temper-server/src/state/dispatch/mod.rs",
          "crates/temper-server/src/state/pending_decisions.rs"
        ],
        "evidence": [
          "`dispatch_wasm_integrations_internal` (`wasm.rs:24+`) performs integration discovery, module lookup, authz wiring, secret resolution, engine invocation, failure branching, telemetry emission, and callback dispatch in one loop.",
          "`handle_wasm_failure` (`:300+`) adds persistence and metrics concerns, while `record_wasm_authz_denial` (`:420+`) additionally pushes pending decisions, persists asynchronously, creates governance entities, and writes trajectory entries.",
          "Top-level dispatch module (`dispatch/mod.rs`) exposes this as part of core dispatch behavior, further coupling entity-action flow with governance/audit mechanics."
        ],
        "suggestion": "Split into composable stages (`resolve_integration`, `invoke_module`, `classify_failure`, `emit_observability`, `emit_governance_effects`) with a typed outcome object; keep governance decision generation as a separate post-invocation handler.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-03-05T22:14:24+00:00",
      "last_seen": "2026-03-05T22:14:24+00:00",
