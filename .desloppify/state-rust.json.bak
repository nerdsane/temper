    "review::.::holistic::logic_clarity::entity_history_tenant_key_mismatch::42ca2f1d": {
      "id": "review::.::holistic::logic_clarity::entity_history_tenant_key_mismatch::42ca2f1d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Entity history fallback queries wrong persistence key shape, risking cross-tenant misses/leakage",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "crates/temper-server/src/observe/entities.rs",
          "crates/temper-server/src/entity_actor/actor.rs",
          "crates/temper-server/src/state/entity_ops.rs"
        ],
        "evidence": [
          "`get_entity_history` uses tenant-scoped actor key (`{tenant}:{entity_type}:{entity_id}`) but event-store fallback reads `format!(\"{entity_type}:{entity_id}\")` (`observe/entities.rs:64,101-102`).",
          "Entity persistence/replay consistently use tenant-prefixed IDs (`entity_actor/actor.rs:104-107`) and store-loading does the same (`state/entity_ops.rs:435-436`)."
        ],
        "suggestion": "Normalize persistence ID construction through a shared helper used by actor persistence, state hydration, and observe history endpoints; include tenant in fallback reads and add regression tests for same `entity_type/entity_id` across two tenants.",
        "reasoning": ""
      },
