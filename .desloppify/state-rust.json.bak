    "review::.::holistic::high_level_elegance::insight_generator_is_multi_domain_hub::80b65869": {
      "id": "review::.::holistic::high_level_elegance::insight_generator_is_multi_domain_hub::80b65869",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "A single module owns multiple analytics domains, obscuring responsibility boundaries.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "crates/temper-server/src/insight_generator.rs",
          "crates/temper-server/src/observe/evolution/records_list.rs"
        ],
        "evidence": [
          "insight_generator.rs includes three top-level workflows with distinct outcomes (`InsightRecord`, `UnmetIntent`, `FeatureRequestRecord`) and shared heuristics/categorization in one file (lines 48-447).",
          "records_list.rs exposes insights as a separate API concern (`list_evolution_insights` lines 83-128), but upstream generation remains bundled with unrelated unmet-intent and feature-request policy."
        ],
        "suggestion": "Split `insight_generator.rs` into focused modules (for example `insights`, `unmet_intents`, `feature_requests`, `error_taxonomy`) and keep shared utilities minimal; wire them through a small orchestrator so each output type has clear ownership.",
