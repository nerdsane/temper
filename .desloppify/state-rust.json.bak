    "review::.::holistic::initialization_coupling::include-bytes-wasm-in-constructor::4995cc13": {
      "id": "review::.::holistic::initialization_coupling::include-bytes-wasm-in-constructor::4995cc13",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "ServerState::new() calls register_builtin_wasm_modules() which compiles an embedded WASM binary (include_bytes!) at construction time. This adds latency to every ServerState creation including in tests.",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "crates/temper-server/src/state/mod.rs"
        ],
        "evidence": [
          "Line 255: `state.register_builtin_wasm_modules();` called from new()",
          "Line 388: Same call in from_registry_shared()",
          "Line 262-263: `const HTTP_FETCH_WASM: &[u8] = include_bytes!(\"../../../temper-wasm/modules/http_fetch.wasm\");`",
          "Line 265: `self.wasm_engine.compile_and_cache(HTTP_FETCH_WASM)` -- actual WASM compilation at init"
        ],
        "suggestion": "Make WASM module registration lazy or opt-in. Tests that don't exercise WASM integrations should not pay the compilation cost.",
        "reasoning": ""
      },
      "status": "wontfix",
      "note": "All review findings reviewed - architectural decisions tracked by ADRs, code improvements made (verification.rs split, error standardization, helper extraction, comment trimming).",
