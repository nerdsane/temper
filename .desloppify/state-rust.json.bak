    "review::.::holistic::api_surface_coherence::observe-endpoint-inconsistent-error-returns::1b475839": {
      "id": "review::.::holistic::api_surface_coherence::observe-endpoint-inconsistent-error-returns::1b475839",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Observe API endpoints use at least three different error return patterns: Result<Json<T>, StatusCode>, Result<impl IntoResponse, StatusCode>, and direct StatusCode returns. This makes client-side error handling unpredictable -- some errors produce JSON bodies, others produce bare status codes with no body.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "crates/temper-server/src/observe/verification.rs",
          "crates/temper-server/src/observe/specs.rs",
          "crates/temper-server/src/observe/evolution/operations.rs",
          "crates/temper-server/src/observe/entities.rs"
        ],
        "evidence": [
          "verification.rs run_verification returns Result<Json<CascadeResult>, StatusCode>",
          "specs.rs list_specs returns Result<Json<serde_json::Value>, StatusCode>",
          "evolution/operations.rs handlers return StatusCode for errors without JSON bodies",
          "The blind packet's review notes state: 'Observe endpoints use inconsistent error return types'",
          "Some handlers return odata_error() JSON-wrapped errors while observe handlers return bare StatusCode"
        ],
        "suggestion": "Standardize on a single error envelope type for the observe API, such as Result<Json<T>, (StatusCode, Json<ObserveError>)>, to ensure clients always receive structured error information. The OData layer already has a consistent odata_error() pattern that could serve as a model.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
