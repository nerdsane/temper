    "review::.::holistic::authorization_consistency::observe_endpoints_not_tenant_scoped_after_auth::7d901280": {
      "id": "review::.::holistic::authorization_consistency::observe_endpoints_not_tenant_scoped_after_auth::7d901280",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Observe handlers authorize once but return cross-tenant data without tenant-bound filtering",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "crates/temper-server/src/authz_helpers.rs",
          "crates/temper-server/src/observe/entities.rs",
          "crates/temper-server/src/observe/specs.rs",
          "crates/temper-server/src/events.rs"
        ],
        "evidence": [
          "`require_observe_auth` checks action/resource with empty attrs (`authz_helpers.rs:60-65`), so tenant/resource instance is not part of the decision input.",
          "`list_entities` iterates all actor registry keys and returns all entities regardless of tenant (`observe/entities.rs:30-51`).",
          "`list_specs` iterates `registry.tenant_ids()` and returns every tenant\u2019s specs (`observe/specs.rs:30-67`).",
          "SSE events stream all tenant changes to any caller that passes one global observe permission (`events.rs:47-58`)."
        ],
        "suggestion": "Introduce tenant- and resource-scoped observe authorization: extract tenant context first, include it in Cedar context/resource attrs, and filter query/stream outputs to authorized tenants only. For cross-tenant admin views, use explicit elevated actions and separate handler paths.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-03-05T22:14:24+00:00",
