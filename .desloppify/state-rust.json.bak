      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "EntityActor::pre_start checks self.event_store twice in succession with redundant guard logic",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "crates/temper-server/src/entity_actor/actor.rs"
        ],
