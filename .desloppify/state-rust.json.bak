    "review::.::holistic::initialization_coupling::env-var-reads-in-struct-constructor::947aa026": {
      "id": "review::.::holistic::initialization_coupling::env-var-reads-in-struct-constructor::947aa026",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "ServerState::new() reads environment variables via env_bool() and env_timeout() at construction time. While annotated with // determinism-ok, this couples initialization to the process environment and makes testing harder since different test cases cannot easily override these values.",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "crates/temper-server/src/state/mod.rs"
        ],
        "evidence": [
          "Lines 93-101: `fn env_bool(name: &str, default: bool) -> bool { match std::env::var(name) { // determinism-ok: read once at startup` }",
          "Lines 104-111: `fn env_timeout() -> Duration { std::env::var(\"TEMPER_ACTION_TIMEOUT_SECS\") // determinism-ok: read once at startup`",
          "Lines 237-238: `cross_invariant_enforce: env_bool(\"TEMPER_XINV_ENFORCE\", true)` in constructor",
          "The with_cross_invariant_enforcement() builder method exists but callers must know to use it to override env vars"
        ],
        "suggestion": "Accept these as explicit constructor parameters (with defaults) or introduce a ServerConfig struct that can be constructed from env vars at the entry point and passed down. This keeps the constructor deterministic and simplifies testing.",
        "reasoning": ""
      },
      "status": "wontfix",
