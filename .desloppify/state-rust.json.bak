    "review::.::holistic::abstraction_fitness::semantic_inference_duplication::ea1284f5": {
      "id": "review::.::holistic::abstraction_fitness::semantic_inference_duplication::ea1284f5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Action-name heuristic semantics are duplicated across runtime and verification builders.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/temper-jit/src/table/builder.rs",
          "crates/temper-verify/src/model/builder.rs"
        ],
        "evidence": [
          "Runtime table builder infers increment/decrement effects from action name when explicit effects are absent (`table/builder.rs:155-170`).",
          "Verification model builder repeats the same fallback heuristic (`model/builder.rs:94-112`), creating dual semantic sources that can drift."
        ],
        "suggestion": "Centralize fallback inference in one shared translator crate/module and have both runtime and verification consume the same resolved transition representation.",
        "reasoning": ""
      },
